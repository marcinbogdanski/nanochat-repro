{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Module base_train",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.base_train",
            "env": {
                "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
                "CUDA_VISIBLE_DEVICES": "3"
            },
            "args": [
                "--depth=4",
                "--total-batch-size=262144",
                "--device-batch-size=8",
                "--no-fa",
                "--eval-every=10",
                "--eval-tokens=524288",
                "--core-metric-every=0",
                "--sample-every=0",
                "--save-every=10",
                "--num-iterations=4",
                "--deterministic",
                "--log-metrics"
            ]
        },
        {
            "name": "Python Debugger: torchrun",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "subProcess": true,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0",
                "OMP_NUM_THREADS": "1"
            },
            "args": [
                "--standalone",
                "--nproc_per_node=1",
                "-m",
                "scripts.base_train",
                "--",
                "--depth=4",
                "--num-iterations=2",
                "--eval-every=-1",
                "--eval-tokens=65536",
                "--core-metric-every=-1",
                "--sample-every=-1",
                "--save-every=-1"
            ]
        },
        {
            "name": "Python Debugger: Module chat_sft",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.chat_sft",
            "env": {
                "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
                "CUDA_VISIBLE_DEVICES": "3"
            },
            "args": [
            ]
        }
    ]
}
