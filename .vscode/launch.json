{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Module (moe)",
            "type": "debugpy",
            "request": "launch",
            "module": "dev.microbenchmark_moe",
        },
        {
            "name": "Python Debugger: Module",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.base_train",
            "env": {
                "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
                "CUDA_VISIBLE_DEVICES": "0"
            },
            "args": [
                "--depth=4",
                "--total-batch-size=262144",
                "--device-batch-size=8",
                "--eval-every=10",
                "--eval-tokens=524288",
                "--core-metric-every=0",
                "--sample-every=0",
                "--save-every=10",
                "--num-iterations=4",
                "--log-every=1",
                "--deterministic",
                "--window-pattern=L"
            ]
        }
    ]
}